# =============================================================================
#  .env.example — Online Code Judge Platform
#  Copy this file to .env for local development.
#  NEVER commit .env or any file containing real secrets to Git.
# =============================================================================

NODE_ENV=development

# ----- API & Web Ports -----
API_PORT=4000
PORT=4000
WEB_PORT=5173
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ----- Database (PostgreSQL 16) -----
POSTGRES_USER=judge_user
POSTGRES_PASSWORD=judge_secret_password
POSTGRES_DB=judge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://judge_user:judge_secret_password@localhost:5432/judge_db

# ----- Redis 7 & BullMQ -----
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- MinIO (S3-compatible Object Storage for Test Cases) -----
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=judge-testcases
MINIO_BUCKET_NAME=judge-testcases
MINIO_USE_SSL=false

# ----- Auth, JWT & Cookies (CHANGE IN PRODUCTION) -----
JWT_SECRET=dev-only-jwt-secret-change-me-min-32-chars
COOKIE_SECRET=dev-only-cookie-secret-change-me-32chars
AUTH_COOKIE_NAME=token
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32chars
JWT_REFRESH_EXPIRES_IN=7d

# ----- Email (Stub Mail Service) -----
STUB_MAIL_URL=http://localhost:4005
STUB_MAIL_PORT=4005

# ----- Sandbox Container Defaults -----
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_DOCKER_IMAGE=node:20-alpine

# ----- Cron Scheduler -----
CRON_PORT=4002
