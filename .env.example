# Environment Configuration Example
# Copy to .env for local development

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=judge_user
POSTGRES_PASSWORD=judge_secret_password
POSTGRES_DB=judge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://judge_user:judge_secret_password@localhost:5432/judge_db

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3 compatible object storage for test cases)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=judge-testcases

# Auth & JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Sandbox Limits (Defaults)
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_DOCKER_IMAGE=node:20-alpine

# Kafka (Tier 2)
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=online-code-judge

