# =============================================================================
#  .env.example — Online Code Judge Platform
#  Copy this file to .env for local development or production configuration.
#  NEVER commit .env or any file containing real production secrets to Git.
# =============================================================================

# Execution environment: 'development' | 'production' | 'test'
NODE_ENV=development

# ----- API & Web Routing -----
API_PORT=4000
PORT=4000
WEB_PORT=5173
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ----- Database (PostgreSQL 16) -----
# In production, replace user, strong random password, hostname, and database name.
POSTGRES_USER=judge_user
POSTGRES_PASSWORD=judge_secret_password
POSTGRES_DB=judge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://judge_user:judge_secret_password@localhost:5432/judge_db

# ----- Redis 7 & BullMQ -----
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- MinIO (S3-compatible Object Storage for Test Cases) -----
# In production, generate strong access/secret keys and do not use minioadmin.
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=judge-testcases
MINIO_BUCKET_NAME=judge-testcases
MINIO_USE_SSL=false

# ----- Auth, JWT & Cookies (MUST BE CHANGED IN PRODUCTION) -----
# Generate secrets using `openssl rand -hex 32` (minimum 32 characters).
# Production validator blocks default strings containing 'dev-only' or 'change-me'.
JWT_SECRET=dev-only-jwt-secret-change-me-min-32-chars
COOKIE_SECRET=dev-only-cookie-secret-change-me-32chars
AUTH_COOKIE_NAME=token
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32chars
JWT_REFRESH_EXPIRES_IN=7d

# ----- Email (Stub Mail Service) -----
STUB_MAIL_URL=http://localhost:4005
STUB_MAIL_PORT=4005

# ----- Judge Worker & Sandbox Configuration -----
WORKER_CONCURRENCY=2
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=15000
WORKER_MAX_STALLED_COUNT=2
WORKER_MAX_ATTEMPTS=3
RECOVERY_STALE_MS=60000
RECOVERY_INTERVAL_MS=30000
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_DOCKER_IMAGE=node:20-alpine
SANDBOX_PYTHON_IMAGE=python:3.11-alpine

# ----- Cron Scheduler -----
CRON_PORT=4002
