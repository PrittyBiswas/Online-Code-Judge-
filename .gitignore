# ============================================================
#  .gitignore — Online Code Judge Monorepo
# ============================================================

# ----- Dependencies -----
node_modules/
.pnpm-store/
.npm/

# ----- Build Outputs -----
dist/
build/
*.tsbuildinfo
.turbo/

# ----- Environment & Secrets (NEVER COMMIT THESE) -----
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ----- Docker Volumes & Local Data -----
.minio-data/
.pg-data/
.redis-data/
docker-data/

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Test Coverage & Scratch -----
coverage/
temp/
scratch/
.nyc_output/

# ----- Editor & IDE -----
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- Vitest -----
.vitest-cache/

# ----- Frontend Vite -----
apps/frontend/.vite/
