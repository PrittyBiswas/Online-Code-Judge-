{
  "name": "online-code-judge",
  "version": "1.0.0",
  "private": true,
  "description": "A secure, scalable Online Code Judge platform with TypeScript, Docker sandboxing, BullMQ, Redis, PostgreSQL, and React.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:services": "docker compose up -d",
    "stop:services": "docker compose down",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/judge-worker",
    "dev:cron": "npm run dev --workspace=apps/cron",
    "dev:mail": "npm run dev --workspace=apps/stub-mail",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:worker": "npm run build --workspace=apps/judge-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "env:validate": "tsx scripts/verify-environment.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "packageManager": "pnpm@9.0.0"
}
