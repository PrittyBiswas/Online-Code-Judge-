{
  "name": "online-code-judge",
  "version": "1.0.0",
  "private": true,
  "description": "A secure, scalable Online Code Judge platform with TypeScript, Docker sandboxing, BullMQ, Redis, PostgreSQL, and React.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @judge/api --filter @judge/frontend --parallel dev",
    "dev:api": "pnpm --filter @judge/api dev",
    "dev:frontend": "pnpm --filter @judge/frontend dev",
    "dev:worker": "pnpm --filter @judge/worker dev",
    "dev:cron": "pnpm --filter @judge/cron dev",
    "dev:mail": "pnpm --filter @judge/stub-mail dev",
    "build": "pnpm --filter @judge/shared build && pnpm -r --filter=!@judge/shared build",
    "build:shared": "pnpm --filter @judge/shared build",
    "build:api": "pnpm --filter @judge/api build",
    "build:frontend": "pnpm --filter @judge/frontend build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:validate": "tsx scripts/verify-environment.ts",
    "infra:verify": "tsx scripts/verify-infrastructure.ts",
    "dev:services": "docker compose up -d",
    "stop:services": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "zod": "^3.22.4"
  }
}
