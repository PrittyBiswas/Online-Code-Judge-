{
  "name": "online-code-judge",
  "version": "1.0.0",
  "private": true,
  "description": "A secure, scalable Online Code Judge built with TypeScript, Docker sandbox, BullMQ, Redis, PostgreSQL, and React.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "dev:services": "docker compose up -d",
    "stop:services": "docker compose down",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "packageManager": "pnpm@9.0.0"
}
